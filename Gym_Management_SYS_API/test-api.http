# IronForge Gym API - Test Requests
# Use with REST Client extension in VS Code

@baseUrl = http://localhost:5000
@token = YOUR_ACCESS_TOKEN_HERE

### Health Check
GET {{baseUrl}}/health

### ============================================
### AUTHENTICATION ENDPOINTS
### ============================================

### Register New Member
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "password123",
  "fullName": "Test User",
  "phone": "+1234567899"
}

### Login (Admin)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@ironforge.com",
  "password": "password123"
}

### Login (Member - John)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "john@ironforge.com",
  "password": "password123"
}

### Login (Coach)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "coach@ironforge.com",
  "password": "password123"
}

### Get Current User Info
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### Logout
POST {{baseUrl}}/api/auth/logout
Authorization: Bearer {{token}}

### ============================================
### MEMBERSHIP PLANS
### ============================================

### Get All Plans (Public)
GET {{baseUrl}}/api/plans

### Get Plan by ID
GET {{baseUrl}}/api/plans/PLAN_ID_HERE

### Create New Plan (Admin only)
POST {{baseUrl}}/api/plans
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tier": "Tier 04",
  "name": "Student Special",
  "description": "Affordable plan for students",
  "price": 59,
  "duration": "monthly",
  "features": ["Basic access", "Locker room", "Mobile app"],
  "accessLevel": "basic",
  "displayOrder": 4,
  "colorCode": "#fbbf24"
}

### ============================================
### MEMBERS
### ============================================

### Get All Members (Admin/Manager only)
GET {{baseUrl}}/api/members?page=1&limit=20
Authorization: Bearer {{token}}

### Get Current Member Profile
GET {{baseUrl}}/api/members/me
Authorization: Bearer {{token}}

### Update Current Member Profile
PUT {{baseUrl}}/api/members/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phone": "+1234567890",
  "address": "123 New Street, City, State 12345",
  "emergencyContact": "Jane Doe - +0987654321"
}

### Get Member by ID
GET {{baseUrl}}/api/members/USER_ID_HERE
Authorization: Bearer {{token}}

### Get Member Subscription
GET {{baseUrl}}/api/members/USER_ID_HERE/subscription
Authorization: Bearer {{token}}

### Get Member Attendance
GET {{baseUrl}}/api/members/USER_ID_HERE/attendance?page=1&limit=10
Authorization: Bearer {{token}}

### ============================================
### SUBSCRIPTIONS
### ============================================

### Get All Subscriptions (Admin/Manager)
GET {{baseUrl}}/api/subscriptions?page=1&limit=20
Authorization: Bearer {{token}}

### Get Expiring Subscriptions
GET {{baseUrl}}/api/subscriptions/expiring?days=7
Authorization: Bearer {{token}}

### Create Subscription (Admin/Manager)
POST {{baseUrl}}/api/subscriptions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": "USER_ID_HERE",
  "planId": "PLAN_ID_HERE",
  "paymentMethod": "card",
  "autoRenew": true
}

### Cancel Subscription
DELETE {{baseUrl}}/api/subscriptions/SUBSCRIPTION_ID_HERE
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Member requested cancellation"
}

### ============================================
### ATTENDANCE
### ============================================

### Check-In Member
POST {{baseUrl}}/api/attendance/check-in
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": "USER_ID_HERE",
  "location": "Main Gate"
}

### Check-Out Member
POST {{baseUrl}}/api/attendance/check-out
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "attendanceId": "ATTENDANCE_ID_HERE"
}

### Get Today's Attendance
GET {{baseUrl}}/api/attendance/today
Authorization: Bearer {{token}}

### Get All Attendance Records
GET {{baseUrl}}/api/attendance?page=1&limit=20&date=2024-11-01
Authorization: Bearer {{token}}

### Get Member Attendance
GET {{baseUrl}}/api/attendance/member/USER_ID_HERE?page=1&limit=10
Authorization: Bearer {{token}}

### ============================================
### PAYMENTS
### ============================================

### Get All Payments (Admin/Manager)
GET {{baseUrl}}/api/payments?page=1&limit=20
Authorization: Bearer {{token}}

### Get Payment Statistics
GET {{baseUrl}}/api/payments/stats
Authorization: Bearer {{token}}

### Get Member Payments
GET {{baseUrl}}/api/payments/member/USER_ID_HERE?page=1&limit=10
Authorization: Bearer {{token}}

### Process Payment (Admin/Manager)
POST {{baseUrl}}/api/payments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": "USER_ID_HERE",
  "subscriptionId": "SUBSCRIPTION_ID_HERE",
  "amount": 79.00,
  "currency": "USD",
  "paymentMethod": "card",
  "paymentType": "subscription",
  "description": "Monthly membership payment",
  "transactionId": "TXN-123456789"
}

### ============================================
### SEARCH AND FILTERS
### ============================================

### Search Members by Name
GET {{baseUrl}}/api/members?search=john&page=1&limit=20
Authorization: Bearer {{token}}

### Filter Members by Status
GET {{baseUrl}}/api/members?status=active&page=1&limit=20
Authorization: Bearer {{token}}

### Filter Subscriptions by Status
GET {{baseUrl}}/api/subscriptions?status=active&page=1&limit=20
Authorization: Bearer {{token}}

### Filter Payments by Date Range
GET {{baseUrl}}/api/payments?startDate=2024-01-01&endDate=2024-12-31
Authorization: Bearer {{token}}

### ============================================
### ERROR SCENARIOS (for testing)
### ============================================

### Try to register with existing email
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "john@ironforge.com",
  "password": "password123",
  "fullName": "Duplicate User"
}

### Try to login with wrong password
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "john@ironforge.com",
  "password": "wrongpassword"
}

### Try to access protected route without token
GET {{baseUrl}}/api/members/me

### Try to access admin route as member
GET {{baseUrl}}/api/members
Authorization: Bearer MEMBER_TOKEN_HERE
